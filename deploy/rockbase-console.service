[Unit]
Description=Rockbase localhost operations console
After=network.target

[Service]
Type=simple
User=rockbase
Group=rockbase
WorkingDirectory=/opt/rockbase
EnvironmentFile=-/etc/rockbase/console/environment
ExecStart=/usr/bin/python3 -m console.server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/rockbase/console /var/lib/rockbase

[Install]
WantedBy=multi-user.target
